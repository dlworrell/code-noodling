# Build trees
/build/
/cmake-build-*/
/out/
CMakeCache.txt
CMakeFiles/
Makefile
*.make
*.ninja
*.ninja_deps
*.ninja_log

# Compiled objects
*.o
*.obj
*.lo
*.a
*.lib
*.dll
*.dylib
*.so
*.exp
*.pdb
*.ilk

# IDE & misc
*.user
*.vcxproj*
*.sln
.DS_Store
.vscode/
.idea/
.tools/
__pycache__/
*.py[cod]

# Generated data
*.json
*.csv
*.log

# Election inputs, their provenance records (SOURCES.json) and EDT-generated
# evidence are deliberately versioned. The source watcher's publisher stages
# with `git add`, so anything ignored here would silently never be published
# (tests/test_election_watch.py checks these paths).
!election-data/**/*.csv
!election-data/**/*.csv.xls
!election-data/**/*.json
!reports/elections/**/*.json
!reports/elections/**/county-breakdown.csv

# crypto_pipeline provenance and evidence records (provenance baseline, scope
# manifest, proof and timing evidence) must be committed the same way
# (crypto_pipeline/tests/test_repository_files.py checks these paths).
!crypto_pipeline/**/*.json
